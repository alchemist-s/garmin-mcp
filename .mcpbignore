# The host resolves dependencies with uv, so a bundled environment must not ship.
.venv/
server/lib/
server/venv/

.git/
.github/
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc
dist/
build/
*.egg-info/

tests/

# Website files belong on Vercel, not inside the extension.
site/
vercel.json
.mcpbignore
*.mcpb
.DS_Store
